import java.util.*;
public class stringDemo5{
    public static void main(String[] args){
        StringBuffer sb=new StringBuffer("Usama");
        System.out.println(sb);
        //append method                       
        sb.append(" Bin");
        System.out.println(sb);
        //reverse menthod
        sb.reverse();
        System.out.println(sb);
        //delete method
        sb.delete(0,4);
        System.out.println(sb);
        //setLength
        sb.setLength(3);
        System.out.println(sb);
    }
}
